{
  "name": "pos-api",
  "version": "0.1.0",
  "description": "Enterprise POS System - Backend API",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "pretest": "NODE_ENV=test npm run migrate:up",
    "test": "NODE_ENV=test node --test",
    "migrate:create": "node-pg-migrate create --migrations-dir src/db/migrations --",
    "migrate:up": "node-pg-migrate up --migrations-dir src/db/migrations --envPath .env.${NODE_ENV:-development}",
    "migrate:down": "node-pg-migrate down --migrations-dir src/db/migrations --envPath .env.${NODE_ENV:-development}"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.18.0",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
