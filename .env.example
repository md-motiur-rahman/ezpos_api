# ==========================================================
# POS API - Environment Variables
# Copy this file to .env.development / .env.staging / .env.production
# and fill in real values. Never commit actual .env.* files.
# ==========================================================

# --- Core (Module 0.1) ---
NODE_ENV=development
PORT=4000

# --- Database (added in Module 0.3) ---
# DATABASE_URL=

# --- Auth / JWT (Module 1.2) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# --- Stripe (added in Module 3) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Email (added in Module 1, for verification emails) ---
# EMAIL_FROM=
# EMAIL_PROVIDER_API_KEY=

# --- CORS (Module 0.2) ---
# Comma-separated list of origins allowed to call this API from a browser.
# Leave empty in development to allow all origins (convenience only).
# Required in staging/production - e.g. https://dashboard.yourpos.com
CORS_ALLOWED_ORIGINS=

# --- Database (Module 0.3) ---
# Local dev: postgres://user:password@localhost:5432/pos_dev
# Render managed Postgres: use the "Internal Connection String" it provides
DATABASE_URL=postgres://postgres:j4c5cAr4@localhost:5433/ezpos-db